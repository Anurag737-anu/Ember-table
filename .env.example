DATABASE_URL=postgresql://ember:ember_local_only@localhost:5432/ember
PORT=3001
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
# Explicitly demo only: never enable with NODE_ENV=production
DEMO_MODE=true
# Set before seeding: at least 12 characters
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=replace-with-long-local-password
# Live Razorpay server credentials; key ID is returned to Checkout
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional email and AI
RESEND_API_KEY=
EMAIL_FROM=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Google Maps Embed key, restrict by HTTP referrer and API
VITE_GOOGLE_MAPS_KEY=
# Add a licensed local clip at public/media/kitchen.mp4 or supply HTTPS URL
VITE_HERO_VIDEO=
